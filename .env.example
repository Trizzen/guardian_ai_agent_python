# Optional local server overrides.
JAZA_HOST=127.0.0.1
JAZA_PORT=5001
# Optional test/alternate location. The normal default is ~/.codex/config.toml.
# JAZA_CODEX_CONFIG_PATH=/absolute/path/to/config.toml

# GuardThisKingdom read-only evidence. Prefer a dedicated DB credential whose
# database permissions are SELECT-only. Jaza accepts GTK's existing `params`
# or `SQLALCHEMY_DATABASE_URI` name from this referenced local file.
# JAZA_GTK_ENV_FILE=/absolute/path/to/gtk/.env
# Or set the URI directly in the process (never commit the real value):
# JAZA_GTK_DATABASE_URI=mssql+pymssql://readonly_user:placeholder@host/database

# Luna uses the exact same OPENAI_API_KEY contract as MenuShield. This optional
# pointer reads only OPENAI_API_KEY and OPENAI_MODEL; it does not import other
# values from the referenced file or copy the key into this repository.
# JAZA_SHARED_OPENAI_ENV_FILE=/absolute/path/to/menushield/.env
JAZA_LUNA_MODEL=gpt-5.6-luna
JAZA_LUNA_REASONING_EFFORT=low
JAZA_LUNA_TIMEOUT_SECONDS=90
JAZA_REPORT_CACHE_TTL_SECONDS=3600


JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

GITHUB_OWNER=
GITHUB_TOKEN=